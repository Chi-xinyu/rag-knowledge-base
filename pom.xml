<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <!--
        这是 Maven 的"项目对象模型"文件，Maven 靠它知道：
        项目用什么父模板、Java 版本、依赖哪些库、怎么打包运行。
        你不需要记语法，只需按注释改"该改的地方"。
    -->

    <!-- 唯一必须改的：模型版本，固定这个值即可，不要动 -->
    <modelVersion>4.0.0</modelVersion>

    <!--
        parent 表示"继承 Spring Boot 官方父工程"。
        好处：Spring Boot 相关依赖的版本号全都由它统一管理，
        你在下面写依赖时【不用写版本号】，Maven 会自动匹配，避免版本冲突。
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- 版本：3.5.16 是 3.x 系列当前维护版，稳定且教程多，配 JDK 21 -->
        <version>3.5.16</version>
        <relativePath/> <!-- 表示父工程不在本地目录，去 Maven 中央仓库找 -->
    </parent>

    <!-- ===== 以下 3 个是"项目坐标"，标识你这个项目，改不改无所谓，但建议见名知义 ===== -->
    <groupId>com.example</groupId>
    <artifactId>rag-knowledge-base</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>rag-knowledge-base</name>
    <description>基于 RAG 的企业知识库问答系统</description>

    <properties>
        <!-- Java 版本：你装的是 JDK 21，这里就写 21，编译时用 21 的语法 -->
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!--
            核心依赖 1：spring-boot-starter-web
            这是"做后端 Web 接口"的起步依赖，自带 Tomcat 服务器 + Spring MVC，
            有了它你才能写 @RestController 接口、接收 HTTP 请求、返回 JSON。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            核心依赖 2：spring-boot-starter-test
            测试专用，自带 JUnit。后面写"接口测试"时用得上，现在先备着。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            ===== 第 2 步新增：数据库 + 缓存依赖 =====
        -->
        <!-- MySQL 驱动：Java 程序通过它连上 MySQL 数据库（JDBC 协议） -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope> <!-- 运行时才需要，编译时用不到 -->
        </dependency>

        <!--
            MyBatis-Plus：国内主流的数据库操作框架（ORM）。
            你只需要写接口和实体类，常用的增删改查它自动帮你实现，
            不用像原生 MyBatis 那样手写一堆 XML。版本 3.5.17 是 Spring Boot 3 专用版。
        -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
            <version>3.5.17</version>
        </dependency>

        <!-- Redis 客户端：通过它操作 Redis 做缓存（后面做限流也用得上） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
            Lombok：编译期自动生成 getter/setter/toString 等样板代码。
            实体类上的 @Data 就是它提供的，加了它代码才能编译通过。
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            ===== 第 4 步新增：多格式文档解析依赖 =====
        -->
        <!-- PDFBox：解析 PDF 文件，把 PDF 里的文字提取出来（3.x 版本，兼容 Java 21） -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.3</version>
        </dependency>

        <!--
            Apache POI：解析 Word(.docx) 和 Excel(.xlsx) 文件。
            poi-ooxml 是"新版 Office 格式"支持包（Word/Excel 都是它管）
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.5</version>
        </dependency>

        <!--
            ===== 第 5 步新增：用户登录体系依赖 =====
            spring-security-crypto：只引入"密码加密"工具（BCrypt），
            不引入整个 Spring Security（那套登录流程对新手太重了）。
            BCrypt 是行业标准密码哈希算法：防破解、防彩虹表。
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-crypto</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                关键插件：spring-boot-maven-plugin
                作用：把项目打成"可执行的 jar"，并能通过 mvn spring-boot:run 直接启动。
                这是 Spring Boot 项目标配，别删。
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
